#!/usr/bin/env python3
"""agent-clip: shared clipboard of shell commands that AI agents hand to the user.

Agents add commands; the user copies them from the menu bar app (or `agent-clip copy`).
Nothing is ever deleted: archiving hides an entry from the menu but keeps it in the log,
so `agent-clip stats` can surface commands worth turning into aliases or tools.

Store: $AGENT_CLIPBOARD_DIR/clips.jsonl (default ~/.agent-clipboard), one JSON object per line.
"""

import argparse
import fcntl
import json
import os
import re
import shlex
import subprocess
import sys
import time
from collections import Counter, defaultdict
from contextlib import contextmanager
from pathlib import Path

STORE_DIR = Path(os.environ.get("AGENT_CLIPBOARD_DIR", Path.home() / ".agent-clipboard"))
STORE = STORE_DIR / "clips.jsonl"
LOCK = STORE_DIR / ".lock"


@contextmanager
def locked():
    STORE_DIR.mkdir(parents=True, exist_ok=True)
    with open(LOCK, "w") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        try:
            yield
        finally:
            fcntl.flock(fh, fcntl.LOCK_UN)


def load():
    if not STORE.exists():
        return []
    clips = []
    for line in STORE.read_text().splitlines():
        line = line.strip()
        if line:
            try:
                clips.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return clips


def save(clips):
    tmp = STORE.with_suffix(".tmp")
    tmp.write_text("".join(json.dumps(c, ensure_ascii=False) + "\n" for c in clips))
    os.replace(tmp, STORE)


def detect_project(cwd):
    try:
        top = subprocess.run(
            ["git", "-C", cwd, "rev-parse", "--path-format=absolute", "--git-common-dir"],
            capture_output=True, text=True, timeout=3,
        ).stdout.strip()
        if top:
            # --git-common-dir resolves worktrees back to the main repo's .git
            return Path(top).parent.name
    except Exception:
        pass
    return Path(cwd).name or "misc"


def detect_agent():
    env = os.environ
    if env.get("CLAUDECODE") or env.get("CLAUDE_CODE_ENTRYPOINT"):
        return "claude"
    if any(k.startswith("CODEX_") for k in env):
        return "codex"
    if any(k.startswith("GROK_") for k in env):
        return "grok"
    return "unknown"


def find(clips, ident):
    for c in clips:
        if str(c["id"]) == str(ident):
            return c
    sys.exit(f"agent-clip: no clip with id {ident}")


def pbcopy(text):
    subprocess.run(["pbcopy"], input=text, text=True, check=True)


def first_line(cmd, width=70):
    line = cmd.strip().splitlines()[0] if cmd.strip() else ""
    more = len(cmd.strip().splitlines()) > 1
    if len(line) > width:
        line = line[: width - 1] + "…"
    elif more:
        line += " …"
    return line


def cmd_add(a):
    if a.command:
        cmd = " ".join(a.command)
    elif not sys.stdin.isatty():
        cmd = sys.stdin.read()
    else:
        sys.exit("agent-clip: pass the command via stdin (heredoc) or after --")
    cmd = cmd.strip("\n")
    if not cmd.strip():
        sys.exit("agent-clip: empty command")
    cwd = os.getcwd()
    with locked():
        clips = load()
        clip = {
            "id": max((c["id"] for c in clips), default=0) + 1,
            "ts": time.time(),
            "project": a.project or detect_project(cwd),
            "cwd": a.cwd or cwd,
            "agent": a.agent or detect_agent(),
            "note": a.note or "",
            "cmd": cmd,
            "copies": [],
            "archived": False,
        }
        clips.append(clip)
        save(clips)
    print(f"agent-clip #{clip['id']} [{clip['project']}] {first_line(cmd)}")


def visible(clips, a):
    out = [c for c in clips if a.all or not c.get("archived")]
    if a.project:
        out = [c for c in out if c["project"] == a.project]
    return out


def cmd_list(a):
    clips = visible(load(), a)
    if a.json:
        print(json.dumps(clips[-a.limit:], ensure_ascii=False, indent=2))
        return
    for c in clips[-a.limit:]:
        mark = "x" if c.get("archived") else "✓" if c.get("copies") else "•"
        when = time.strftime("%m-%d %H:%M", time.localtime(c["ts"]))
        note = f"  ({c['note']})" if c.get("note") else ""
        print(f"{mark} #{c['id']:<4} {when}  [{c['project']}] {first_line(c['cmd'])}{note}")


def cmd_show(a):
    print(find(load(), a.id)["cmd"])


def cmd_copy(a):
    with locked():
        clips = load()
        clip = find(clips, a.id) if a.id else (visible(clips, a) or [None])[-1]
        if not clip:
            sys.exit("agent-clip: nothing to copy")
        pbcopy(clip["cmd"])
        clip.setdefault("copies", []).append(time.time())
        save(clips)
    print(f"copied #{clip['id']}: {first_line(clip['cmd'])}")


def cmd_pull(a):
    """Print a clip (default: newest uncopied for the cwd's project) and record it as used."""
    with locked():
        clips = load()
        if a.id:
            clip = find(clips, a.id)
        else:
            a.project = a.project or detect_project(os.getcwd())
            shown = visible(clips, a)
            clip = next((c for c in reversed(shown) if not c.get("copies")), shown[-1] if shown else None)
        if not clip:
            sys.exit(f"agent-clip: nothing queued for {a.project}")
        clip.setdefault("copies", []).append(time.time())
        save(clips)
    print(clip["cmd"])


def cmd_archive(a):
    with locked():
        clips = load()
        targets = [find(clips, i) for i in a.ids] if a.ids else visible(clips, a)
        if a.copied:
            targets = [c for c in targets if c.get("copies")]
        for c in targets:
            c["archived"] = True
        save(clips)
    print(f"archived {len(targets)} clip(s)")


def cmd_projects(a):
    counts = Counter(c["project"] for c in load() if a.all or not c.get("archived"))
    for p, n in counts.most_common():
        print(f"{n:>4}  {p}")


def normalize(cmd):
    # Collapse whitespace and blank out obvious variable parts so near-duplicates group together.
    s = re.sub(r"\s+", " ", cmd.strip())
    s = re.sub(r"(['\"]).*?\1", "<str>", s)
    s = re.sub(r"\b[0-9a-f]{7,40}\b", "<hash>", s)
    s = re.sub(r"\b\d+\b", "<n>", s)
    return s


def head_tokens(cmd, n):
    try:
        toks = shlex.split(cmd.strip().splitlines()[0], comments=True)
    except (ValueError, IndexError):
        toks = cmd.strip().split()
    toks = [t for t in toks if not re.match(r"^\w+=", t)]  # skip leading env assignments
    return " ".join(toks[:n])


def cmd_stats(a):
    clips = load()
    if a.project:
        clips = [c for c in clips if c["project"] == a.project]
    if a.days:
        cutoff = time.time() - a.days * 86400
        clips = [c for c in clips if c["ts"] >= cutoff]
    if not clips:
        print("no clips")
        return

    def weight(c):
        return 1 + len(c.get("copies", []))

    print(f"{len(clips)} clips, {sum(len(c.get('copies', [])) for c in clips)} copies\n")

    print("Top programs (adds + copies):")
    progs = Counter()
    for c in clips:
        progs[head_tokens(c["cmd"], 1)] += weight(c)
    for p, n in progs.most_common(a.top):
        print(f"  {n:>4}  {p}")

    print("\nTop subcommands:")
    subs = Counter()
    for c in clips:
        subs[head_tokens(c["cmd"], 2)] += weight(c)
    for p, n in subs.most_common(a.top):
        print(f"  {n:>4}  {p}")

    print("\nRepeated command shapes (alias / script candidates):")
    shapes = defaultdict(list)
    for c in clips:
        shapes[normalize(c["cmd"])].append(c)
    ranked = sorted(shapes.items(), key=lambda kv: -sum(weight(c) for c in kv[1]))
    shown = 0
    for shape, cs in ranked:
        if len(cs) < 2:
            continue
        projects = sorted({c["project"] for c in cs})
        print(f"  {sum(weight(c) for c in cs):>4}  {first_line(shape, 90)}")
        print(f"        projects: {', '.join(projects)}")
        shown += 1
        if shown >= a.top:
            break
    if not shown:
        print("  (none yet)")


def main():
    p = argparse.ArgumentParser(prog="agent-clip", description=__doc__.splitlines()[0])
    sub = p.add_subparsers(dest="action", required=True)

    s = sub.add_parser("add", help="add a command (stdin or after --)")
    s.add_argument("-n", "--note", help="one-line description of what it does")
    s.add_argument("-p", "--project", help="project name (default: git repo or cwd name)")
    s.add_argument("--cwd", help="directory the command should run in (default: cwd)")
    s.add_argument("--agent", help="claude | codex | grok (default: auto-detect)")
    s.add_argument("command", nargs=argparse.REMAINDER)
    s.set_defaults(func=cmd_add)

    for name, func, hlp in [("list", cmd_list, "list clips"), ("ls", cmd_list, "alias of list")]:
        s = sub.add_parser(name, help=hlp)
        s.add_argument("-p", "--project")
        s.add_argument("-a", "--all", action="store_true", help="include archived")
        s.add_argument("-l", "--limit", type=int, default=30)
        s.add_argument("--json", action="store_true")
        s.set_defaults(func=func)

    s = sub.add_parser("show", help="print a clip's full command")
    s.add_argument("id")
    s.set_defaults(func=cmd_show)

    s = sub.add_parser("copy", help="copy a clip to the macOS clipboard (default: latest)")
    s.add_argument("id", nargs="?")
    s.add_argument("-p", "--project")
    s.set_defaults(func=cmd_copy, all=False)

    s = sub.add_parser("pull", help="print newest uncopied clip for this project (used by `ac`)")
    s.add_argument("id", nargs="?")
    s.add_argument("-p", "--project")
    s.set_defaults(func=cmd_pull, all=False)

    s = sub.add_parser("archive", help="hide clips from the menu (kept in the log)")
    s.add_argument("ids", nargs="*")
    s.add_argument("-p", "--project")
    s.add_argument("--copied", action="store_true", help="only clips already copied")
    s.set_defaults(func=cmd_archive, all=False)

    s = sub.add_parser("projects", help="list projects with clip counts")
    s.add_argument("-a", "--all", action="store_true", help="include archived")
    s.set_defaults(func=cmd_projects)

    s = sub.add_parser("stats", help="frequent commands: alias / tooling candidates")
    s.add_argument("-p", "--project")
    s.add_argument("-d", "--days", type=int, help="only the last N days")
    s.add_argument("-t", "--top", type=int, default=15)
    s.set_defaults(func=cmd_stats)

    a = p.parse_args()
    if a.action == "add" and a.command and a.command[0] == "--":
        a.command = a.command[1:]
    a.func(a)


if __name__ == "__main__":
    main()
